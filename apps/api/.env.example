# Copy to .env for local runs. Never commit this file.

# --- model -----------------------------------------------------------------
# Empty SENTINEL_MODEL_PATH => mock detector (mock mode, no weights needed)
SENTINEL_MODEL_PATH=
SENTINEL_MODEL_ID=sentinel-det-v1
# sha256 of the .onnx file; set in production to pin the graph
SENTINEL_MODEL_SHA=
SENTINEL_THREADS=4

# --- inference -------------------------------------------------------------
SENTINEL_CONF=0.35
SENTINEL_IOU=0.45

# --- ingest caps (public endpoint) ----------------------------------------
SENTINEL_MAX_FRAMES=8
SENTINEL_MAX_BYTES=2000000
SENTINEL_RATE_PER_MIN=10
SENTINEL_DAILY_CAP=2000

# --- governance ------------------------------------------------------------
SENTINEL_RETENTION_H=24
SENTINEL_AUDIT_DIR=audit
SENTINEL_AUDIT_MEMORY=200

# --- server ----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
